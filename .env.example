# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.
#
# Variables prefixed `EXPO_PUBLIC_` are bundled into the client app.
# DO NOT put server-only secrets (service-role keys, third-party API keys) here.
# Those go in EAS Secrets or Supabase Vault.

# Supabase ----------------------------------------------------------------
# Project URL and anon key are designed to be public when paired with RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by `pnpm db:types`, never bundled
SUPABASE_PROJECT_ID=your-project-ref

# Sentry (DSN is designed-public) -----------------------------------------
EXPO_PUBLIC_SENTRY_DSN=https://example@example.ingest.sentry.io/0

# PostHog (project key is designed-public) -------------------------------
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Environment label (development | preview | production) ------------------
EXPO_PUBLIC_ENV=development
